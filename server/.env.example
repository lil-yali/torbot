# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# --- Database ---
# Set to true to use a local on-disk Postgres (PGlite) — no external DB needed (great for dev).
USE_LOCAL_DB=true
# Used only when USE_LOCAL_DB is not "true". A normal Postgres connection string (Neon/Railway/etc.).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Server ---
PORT=3000
# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Business timezone (naive appointment times are interpreted in this zone).
TZ=Asia/Jerusalem

# --- Groq (the bot's AI brain) ---
GROQ_API_KEY=your-groq-api-key

# --- Twilio (WhatsApp transport). Optional for local chat testing. ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The WhatsApp sender, e.g. the sandbox number:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Route all inbound WhatsApp-sandbox messages to one business (sandbox shares a single number).
# Leave EMPTY in production so each business is routed by the number the message was sent to.
SANDBOX_BUSINESS_PHONE=+972500000001
# Production security: verify inbound webhooks are really from Twilio.
VALIDATE_TWILIO=false
# The exact public URL Twilio calls (needed when VALIDATE_TWILIO=true), e.g. https://yourdomain.com/webhook
PUBLIC_WEBHOOK_URL=

# --- Reminders ---
# When "true", the 24h reminder scheduler actually sends WhatsApp messages.
# Otherwise it runs in dry-run mode (logs what it would send). Default: dry-run.
ENABLE_REMINDERS=false
# Optional: Twilio Content template SID (HX...) for reminder messages. Business-initiated
# WhatsApp messages (outside the 24h window) require an approved template. Leave empty to
# send plain text (only valid within 24h of the customer's last message).
REMINDER_TEMPLATE_SID=
